# Local access only by default. Generate a long, private password before sharing a server.
APP_PASSWORD=
APP_HOST=127.0.0.1
APP_PORT=8765
# Optional OpenAI-compatible server-side API. Keys never go to the browser.
AI_API_KEY=
# Leave blank to edit the HTTPS provider URL in Settings.
AI_BASE_URL=
AI_MODEL=
# json_schema (default); use json_object only for providers without schema support.
AI_RESPONSE_FORMAT=json_schema
# Optional email delivery. Enable the recipient and channel in Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Use HTTPS + this flag behind a trusted reverse proxy for remote use.
COOKIE_SECURE=false
# Optional one-shot company-source search (Brave Search API); may incur provider fees.
# No scheduled searches. Preview and confirm generic queries in Settings first.
BRAVE_SEARCH_API_KEY=
